# Database Configuration
DB_DEBUG=false
DB_HOST=your_db_host
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# SMTP Configuration (Gmail)
# For Gmail SMTP, use port 587 with App Password
# See: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=officialcompany@gmail.com
SMTP_PASS=your_16_digit_app_password
SMTP_FROM=support@swaadesehat.in
ORDER_CONFIRMATION_ADMIN_EMAIL=admin@example.com

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_PUBLIC_KEY=your_jwt_public_key

# Server Configuration
EXPRESS_PORT=5000
API_BASE_URL=https://api.swaadesehat.in

# DevCrafter Configuration
DEVCRAFTER_KEY=your_devcrafter_key
DEVCRAFTER_SECRET=your_devcrafter_secret
DEVCRAFTER_TOKEN=your_devcrafter_token

# ImageKit Configuration
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL=https://ik.imagekit.io/your_imagekit_id
